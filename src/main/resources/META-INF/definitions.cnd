<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<mcp = 'http://www.jahia.org/jahia/mcp/1.0'>
<mcpmix = 'http://www.jahia.org/jahia/mcpmix/1.0'>
<mix = 'http://www.jcp.org/jcr/mix/1.0'>

// jmix:droppableContent: the skills container and its sub-folders are jnt:contentList (as created by
// 1.x), which only accepts droppable children. jmix:hiddenType keeps the module's types out of the
// editors' content-creation pickers. Editing is restricted by the container's ACL (inheritance broken).
[mcpmix:mcp] > jmix:accessControllableContent, jmix:droppableContent, jmix:hiddenType mixin

[mcp:skill] > jnt:content, mcpmix:mcp, mix:title
 - mcp:description (string)
 - mcp:content (string, textarea)

